# fbspider-server 环境变量配置
# 复制此文件为 .env 并填入真实值

# MongoDB
MONGO_URI=mongodb://user:password@host:27017/dbname?authSource=admin
MONGO_DB=plat

# Flask Secret Key（必须修改为随机字符串）
SECRET_KEY=change-me-to-a-random-string

# Account DSL Callback
ACCOUNT_DSL_CALLBACK_URL=https://your-callback-url/callback/account/dsl
ACCOUNT_DSL_CALLBACK_SECRET=your-callback-secret
ACCOUNT_DSL_CALLBACK_ENABLED=1
ACCOUNT_DSL_CALLBACK_BATCH_SIZE=200
ACCOUNT_DSL_CALLBACK_INTERVAL_MINUTES=10
ACCOUNT_DSL_STARTUP_REFRESH_WAIT_SECONDS=20
ACCOUNT_DSL_CALLBACK_LOG_FULL=1

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=ad-creatives
MINIO_SECURE=0
MINIO_PUBLIC_URL=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:7151,http://54.179.56.204:7151
